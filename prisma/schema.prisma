// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  password     String
  name         String
  role         String        @default("CLIENT")
  phone        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]
  documents    Document[]
  appointments Appointment[]
}



model Application {
  id          String   @id @default(cuid())
  appNumber   String   @unique
  destination String
  type        String
  status      String   @default("Review")
  progress    Int      @default(0)
  clientId    String
  client      User     @relation(fields: [clientId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  agentNotes  String?
}

model Document {
  id          String   @id @default(cuid())
  name        String
  type        String
  url         String
  status      String   @default("Pending") // Pending, Verified, Rejected
  clientId    String
  client      User     @relation(fields: [clientId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Blog {
  id          String   @id @default(cuid())
  title       String
  titleAr     String?
  titleFr     String?
  slug        String   @unique
  excerpt     String
  excerptAr   String?
  excerptFr   String?
  image       String
  content     String
  contentAr   String?
  contentFr   String?
  category    String
  author      String
  published   Boolean  @default(true)
  metaTitle   String?
  metaDesc    String?
  keywords    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  title       String
  description String
  icon        String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Destination {
  id             String   @id @default(cuid())
  name           String
  type           String
  processingTime String
  fee            String
  description    String
  image          String
  requirements   String   // JSON stringified array of requirements
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Appointment {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String
  phone       String
  visaType    String
  serviceType String?
  date        DateTime
  time        String
  notes       String?
  status      String   @default("Pending")
  clientId    String?
  client      User?    @relation(fields: [clientId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OtpVerification {
  id        String   @id @default(cuid())
  phone     String   @unique
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}
